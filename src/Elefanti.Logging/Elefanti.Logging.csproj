<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net9.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    
    <!-- NuGet Package Metadata -->
    <PackageId>Elefanti.Logging</PackageId>
    <Version>1.0.0</Version>
    <Authors>Team Elefanti</Authors>
    <Company>Team Elefanti</Company>
    <Description>Core logging abstractions and utilities for Elefanti.Logging framework</Description>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageProjectUrl>https://github.com/Team-Elefanti/Elefanti.Logging</PackageProjectUrl>
    <RepositoryUrl>https://github.com/Team-Elefanti/Elefanti.Logging</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageTags>logging;elefanti;dotnet</PackageTags>
    <GeneratePackageOnBuild>false</GeneratePackageOnBuild>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Logging" Version="9.0.0" />
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" Version="9.0.0" />
  </ItemGroup>

  <ItemGroup>
    <Folder Include="Logging\" />
    <Folder Include="Providers\" />
  </ItemGroup>

</Project>
